{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencircuit.dev/schemas/expectations.schema.json",
  "title": "OpenCircuit Model Test Expectations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tests"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "evidence_contract_version": { "const": "1.0.0" },
    "evidence_cohorts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceCohort" }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_netlist",
          "analysis_type",
          "scalar_checks",
          "hard_bounds_checks"
        ],
        "properties": {
          "test_netlist": {
            "type": "string",
            "minLength": 5,
            "pattern": "^[^/]+\\.cir$"
          },
          "analysis_type": {
            "enum": [
              "operating_point",
              "dc_sweep",
              "ac_small_signal",
              "transient",
              "noise",
              "thermal",
              "digital"
            ]
          },
          "scalar_checks": {
            "type": "array",
            "items": { "$ref": "#/$defs/scalarCheck" }
          },
          "hard_bounds_checks": {
            "type": "array",
            "items": { "$ref": "#/$defs/hardBoundsCheck" }
          }
        }
      }
    }
  },
  "dependentRequired": {
    "evidence_contract_version": ["evidence_cohorts"],
    "evidence_cohorts": ["evidence_contract_version"]
  },
  "allOf": [
    {
      "if": { "required": ["evidence_contract_version"] },
      "then": {
        "properties": {
          "tests": {
            "contains": {
              "anyOf": [
                { "properties": { "scalar_checks": { "contains": { "required": ["cohort_id"] } } } },
                { "properties": { "hard_bounds_checks": { "contains": { "required": ["cohort_id"] } } } }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "contentAddressedId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "evidenceId": { "$ref": "#/$defs/contentAddressedId" },
    "conditionId": { "$ref": "#/$defs/contentAddressedId" },
    "citationId": { "$ref": "#/$defs/contentAddressedId" },
    "cohortId": { "$ref": "#/$defs/contentAddressedId" },
    "benchConditionId": { "$ref": "#/$defs/contentAddressedId" },
    "evidenceRole": {
      "enum": [
        "typical_observation",
        "inclusive_minimum",
        "inclusive_maximum",
        "inequality_constraint",
        "curve_point"
      ]
    },
    "conditionQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_mode"],
      "properties": {
        "test_mode": { "enum": ["continuous_dc", "pulsed", "single_pulse"] },
        "pulse_width_s": { "type": "number", "exclusiveMinimum": 0 },
        "duty_cycle": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "test_mode": { "enum": ["pulsed", "single_pulse"] } },
            "required": ["test_mode"]
          },
          "then": {
            "if": { "properties": { "test_mode": { "const": "pulsed" } } },
            "then": { "required": ["pulse_width_s", "duty_cycle"] },
            "else": { "required": ["pulse_width_s"] }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["pulse_width_s"] },
                { "required": ["duty_cycle"] }
              ]
            }
          }
        }
      ]
    },
    "citationLocator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "table", "row"],
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "table": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "row": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "figure"],
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "figure": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "curve": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "trace": { "type": "string", "minLength": 1, "pattern": "\\S" }
          },
          "oneOf": [
            { "required": ["curve"] },
            { "required": ["trace"] }
          ]
        }
      ]
    },
    "evidenceCohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "fidelity_tier", "evidence_ids"],
      "properties": {
        "cohort_id": { "$ref": "#/$defs/cohortId" },
        "fidelity_tier": { "const": "F2" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceId" }
        }
      }
    },
    "evidenceLinkageProperties": {
      "properties": {
        "evidence_id": { "$ref": "#/$defs/evidenceId" },
        "condition_id": { "$ref": "#/$defs/conditionId" },
        "citation_id": { "$ref": "#/$defs/citationId" },
        "cohort_id": { "$ref": "#/$defs/cohortId" },
        "bench_condition_id": { "$ref": "#/$defs/benchConditionId" },
        "evidence_role": { "$ref": "#/$defs/evidenceRole" },
        "citation_locator": { "$ref": "#/$defs/citationLocator" },
        "evidence_qualification": { "$ref": "#/$defs/conditionQualification" },
        "bench_qualification": { "$ref": "#/$defs/conditionQualification" }
      },
      "dependentRequired": {
        "evidence_id": ["condition_id", "citation_id", "cohort_id", "bench_condition_id", "evidence_role", "citation_locator", "evidence_qualification", "bench_qualification"],
        "condition_id": ["evidence_id", "citation_id", "cohort_id", "bench_condition_id", "evidence_role", "citation_locator", "evidence_qualification", "bench_qualification"],
        "citation_id": ["evidence_id", "condition_id", "cohort_id", "bench_condition_id", "evidence_role", "citation_locator", "evidence_qualification", "bench_qualification"],
        "cohort_id": ["evidence_id", "condition_id", "citation_id", "bench_condition_id", "evidence_role", "citation_locator", "evidence_qualification", "bench_qualification"],
        "bench_condition_id": ["evidence_id", "condition_id", "citation_id", "cohort_id", "evidence_role", "citation_locator", "evidence_qualification", "bench_qualification"],
        "evidence_role": ["evidence_id", "condition_id", "citation_id", "cohort_id", "bench_condition_id", "citation_locator", "evidence_qualification", "bench_qualification"],
        "citation_locator": ["evidence_id", "condition_id", "citation_id", "cohort_id", "bench_condition_id", "evidence_role", "evidence_qualification", "bench_qualification"],
        "evidence_qualification": ["evidence_id", "condition_id", "citation_id", "cohort_id", "bench_condition_id", "evidence_role", "citation_locator", "bench_qualification"],
        "bench_qualification": ["evidence_id", "condition_id", "citation_id", "cohort_id", "bench_condition_id", "evidence_role", "citation_locator", "evidence_qualification"]
      }
    },
    "expressionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expression"],
      "properties": {
        "kind": { "enum": ["raw_variable", "derived_expression"] },
        "expression": { "type": "string", "minLength": 1 }
      }
    },
    "scalarCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expression_source",
        "expected_value",
        "unit",
        "tolerance",
        "datasheet_citation",
        "placeholder"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expression_source": { "$ref": "#/$defs/expressionSource" },
        "expected_value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["absolute", "relative"],
          "properties": {
            "absolute": { "type": "number", "minimum": 0 },
            "relative": { "type": "number", "minimum": 0 }
          }
        },
        "datasheet_citation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S+"
        },
        "placeholder": { "type": "boolean" },
        "evidence_id": { "$ref": "#/$defs/evidenceId" },
        "condition_id": { "$ref": "#/$defs/conditionId" },
        "citation_id": { "$ref": "#/$defs/citationId" },
        "cohort_id": { "$ref": "#/$defs/cohortId" },
        "bench_condition_id": { "$ref": "#/$defs/benchConditionId" },
        "evidence_role": { "$ref": "#/$defs/evidenceRole" },
        "citation_locator": { "$ref": "#/$defs/citationLocator" },
        "evidence_qualification": { "$ref": "#/$defs/conditionQualification" },
        "bench_qualification": { "$ref": "#/$defs/conditionQualification" }
      },
      "allOf": [{ "$ref": "#/$defs/evidenceLinkageProperties" }]
    },
    "hardBoundsCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expression_source",
        "unit",
        "inclusive",
        "datasheet_citation",
        "placeholder"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expression_source": { "$ref": "#/$defs/expressionSource" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "inclusive": { "type": "boolean" },
        "datasheet_citation": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "boolean" },
        "evidence_id": { "$ref": "#/$defs/evidenceId" },
        "condition_id": { "$ref": "#/$defs/conditionId" },
        "citation_id": { "$ref": "#/$defs/citationId" },
        "cohort_id": { "$ref": "#/$defs/cohortId" },
        "bench_condition_id": { "$ref": "#/$defs/benchConditionId" },
        "evidence_role": { "$ref": "#/$defs/evidenceRole" },
        "citation_locator": { "$ref": "#/$defs/citationLocator" },
        "evidence_qualification": { "$ref": "#/$defs/conditionQualification" },
        "bench_qualification": { "$ref": "#/$defs/conditionQualification" }
      },
      "allOf": [{ "$ref": "#/$defs/evidenceLinkageProperties" }],
      "anyOf": [
        { "required": ["minimum"] },
        { "required": ["maximum"] }
      ]
    }
  }
}
