{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencircuit.dev/schemas/component.schema.json",
  "title": "OpenCircuit Component Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_mpn",
    "manufacturer",
    "description",
    "electrical_family",
    "symbol_pins",
    "spice_pin_mapping",
    "package_variants",
    "ordering_code_aliases",
    "datasheet",
    "model_type",
    "fidelity_tier",
    "domain_coverage",
    "supported_analyses",
    "supported_operating_region",
    "known_omissions",
    "licence",
    "generator",
    "reviewer",
    "test_results",
    "validation_date"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "canonical_mpn": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]*$"
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "electrical_family": {
      "enum": [
        "diode",
        "led",
        "bjt_npn",
        "bjt_pnp",
        "nmos",
        "pmos",
        "jfet_n",
        "jfet_p",
        "opamp",
        "comparator",
        "vreg_linear",
        "logic_74hc",
        "timer",
        "oscillator",
        "resistor",
        "capacitor",
        "inductor",
        "potentiometer",
        "switch",
        "source",
        "other"
      ]
    },
    "symbol_pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "number", "role"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "number": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "spice_pin_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol_pin_number", "subckt_node", "order"],
        "properties": {
          "symbol_pin_number": { "type": "string", "minLength": 1 },
          "subckt_node": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "package_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "standard", "pin_count", "pin_map"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "standard": { "type": "string", "minLength": 1 },
          "pin_count": { "type": "integer", "minimum": 1 },
          "pin_map": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package_pin", "symbol_pin_number"],
              "properties": {
                "package_pin": { "type": "string", "minLength": 1 },
                "symbol_pin_number": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "ordering_code_aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "datasheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "model_type": {
      "enum": ["builtin_primitive", "dot_model", "subckt"]
    },
    "fidelity_tier": {
      "enum": ["F0", "F1", "F2", "F3", "F4"]
    },
    "domain_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dc", "ac", "transient", "noise", "thermal", "digital"],
      "properties": {
        "dc": { "$ref": "#/$defs/coverageRating" },
        "ac": { "$ref": "#/$defs/coverageRating" },
        "transient": { "$ref": "#/$defs/coverageRating" },
        "noise": { "$ref": "#/$defs/coverageRating" },
        "thermal": { "$ref": "#/$defs/coverageRating" },
        "digital": { "$ref": "#/$defs/coverageRating" }
      }
    },
    "supported_analyses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/analysisType" }
    },
    "supported_operating_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "numeric_bounds"],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "summary": { "type": "string", "minLength": 1 },
        "numeric_bounds": {
          "type": "array",
          "items": { "$ref": "#/$defs/numericBound" }
        }
      }
    },
    "known_omissions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx_id", "provenance_basis"],
      "properties": {
        "spdx_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9.-]*|LicenseRef-[A-Za-z0-9.-]+)$"
        },
        "provenance_basis": {
          "enum": ["original_from_facts", "licensed_redistribution", "measured"]
        }
      }
    },
    "generator": { "$ref": "#/$defs/actorRecord" },
    "reviewer": { "$ref": "#/$defs/actorRecord" },
    "test_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "pass_count",
        "fail_count",
        "total_count",
        "worst_observed_relative_fitting_error"
      ],
      "properties": {
        "status": { "enum": ["pending", "complete"] },
        "pass_count": { "type": "integer", "minimum": 0 },
        "fail_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 0 },
        "worst_observed_relative_fitting_error": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "quantity"],
              "properties": {
                "value": { "type": "number", "minimum": 0 },
                "quantity": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "validation_date": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "test_results": {
            "properties": { "status": { "const": "pending" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "test_results": {
            "properties": {
              "pass_count": { "const": 0 },
              "fail_count": { "const": 0 },
              "total_count": { "const": 0 },
              "worst_observed_relative_fitting_error": { "type": "null" }
            }
          },
          "validation_date": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "test_results": {
            "properties": {
              "total_count": { "minimum": 1 },
              "worst_observed_relative_fitting_error": { "type": "object" }
            }
          },
          "validation_date": { "type": "string", "format": "date" }
        }
      }
    }
  ],
  "$defs": {
    "contentAddressedId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "coverageRating": {
      "enum": ["none", "approx", "fitted", "validated"]
    },
    "analysisType": {
      "enum": [
        "operating_point",
        "dc_sweep",
        "ac_small_signal",
        "transient",
        "noise",
        "thermal",
        "digital"
      ]
    },
    "numericBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "unit", "placeholder"],
      "properties": {
        "bound_id": { "$ref": "#/$defs/contentAddressedId" },
        "quantity": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["minimum", "maximum", "range", "enumerated"] },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "number" } },
        "unit": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id", "condition_id", "citation_id", "cohort_id"],
            "properties": {
              "evidence_id": { "$ref": "#/$defs/contentAddressedId" },
              "condition_id": { "$ref": "#/$defs/contentAddressedId" },
              "citation_id": { "$ref": "#/$defs/contentAddressedId" },
              "cohort_id": { "$ref": "#/$defs/contentAddressedId" }
            }
          }
        },
        "condition_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/contentAddressedId" } },
        "citation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/contentAddressedId" } },
        "derivation": { "enum": ["direct_evidence_union", "direct_evidence_intersection"] },
        "temperature_kind": { "enum": ["junction", "ambient", "case"] },
        "conditions": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["minimum"] },
        { "required": ["maximum"] }
      ]
    },
    "actorRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_or_agent", "date"],
      "properties": {
        "tool_or_agent": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" }
      }
    }
  }
}
