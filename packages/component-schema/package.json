{
  "name": "@opencircuit/component-schema",
  "version": "1.0.0",
  "private": true,
  "description": "Schemas and validators for OpenCircuit component model packages",
  "type": "module",
  "bin": {
    "validate-component": "./validate.mjs",
    "validate-package": "./validate-package.mjs"
  },
  "exports": {
    ".": "./lib.mjs",
    "./component.schema.json": "./component.schema.json",
    "./sources.schema.json": "./sources.schema.json",
    "./expectations.schema.json": "./expectations.schema.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
