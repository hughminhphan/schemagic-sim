{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.schemagic.design/design-library/v1/profile-envelope.v1.schema.json",
  "title": "scheMAGIC design profile envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "partClass",
    "part",
    "factsSchemaVersion",
    "commonFacts",
    "facts"
  ],
  "properties": {
    "format": {
      "const": "schemagic-design-profile"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "partClass": {
      "enum": [
        "motor.integrated-h-bridge",
        "motor.full-bridge-gate-driver",
        "power.integrated-synchronous-buck-regulator",
        "power.external-fet-synchronous-buck-controller",
        "shared.n-channel-power-mosfet",
        "shared.current-sense-resistor",
        "shared.general-purpose-resistor",
        "shared.switching-diode",
        "shared.mlcc-capacitor",
        "shared.bulk-capacitor",
        "motor.supply-tvs-diode",
        "power.power-inductor"
      ]
    },
    "part": {
      "$ref": "#/$defs/part"
    },
    "factsSchemaVersion": {
      "const": "1.0.0"
    },
    "commonFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "boardArea",
        "maximumHeight"
      ],
      "properties": {
        "packageName": {
          "$ref": "#/$defs/factText"
        },
        "boardArea": {
          "allOf": [
            {
              "$ref": "#/$defs/profileFact"
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "value",
                        "unit",
                        "displayUnit"
                      ],
                      "properties": {
                        "value": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "unit": {
                          "const": "m2"
                        },
                        "displayUnit": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": ".*\\S.*"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "maximumHeight": {
          "allOf": [
            {
              "$ref": "#/$defs/profileFact"
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "value",
                        "unit",
                        "displayUnit"
                      ],
                      "properties": {
                        "value": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "unit": {
                          "const": "m"
                        },
                        "displayUnit": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": ".*\\S.*"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "facts": {
      "type": "object"
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturerId",
        "manufacturerPartNumber"
      ],
      "properties": {
        "manufacturerId": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "manufacturerPartNumber": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:\\S|\\S.*\\S)$"
        }
      }
    },
    "profileUnit": {
      "enum": [
        "1",
        "A",
        "F",
        "H",
        "Hz",
        "K",
        "V",
        "V_s_per_rad",
        "W",
        "count",
        "m",
        "m2",
        "ohm",
        "rad_per_s",
        "s",
        "C",
        "J",
        "K/W",
        "1/K"
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "displayUnit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "https://schemas.schemagic.design/design-library/v1/profile-envelope.v1.schema.json#/$defs/profileUnit"
        },
        "displayUnit": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceId",
            "locator",
            "retrievedAt",
            "contentHash",
            "licenseNote",
            "kind",
            "url",
            "revision",
            "publicationBasis"
          ],
          "properties": {
            "sourceId": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "licenseNote": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "retrievedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "kind": {
              "enum": [
                "manufacturer_datasheet",
                "manufacturer_product_page",
                "independent_measurement",
                "authored_derivation"
              ]
            },
            "url": {
              "type": "string",
              "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*(?::[0-9]{1,5})?(?:\\/(?:(?:[A-Za-z0-9._~-]|%[0-9A-Fa-f]{2}|[!$&'()*+,;=]|[:@]))*)*(?:\\?(?:(?:(?:[A-Za-z0-9._~-]|%[0-9A-Fa-f]{2}|[!$&'()*+,;=]|[:@])|[/?]))*)?(?:#(?:(?:(?:[A-Za-z0-9._~-]|%[0-9A-Fa-f]{2}|[!$&'()*+,;=]|[:@])|[/?]))*)?$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "publicationBasis": {
              "enum": [
                "public_facts",
                "licensed_redistribution",
                "original_measurement"
              ]
            }
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "manufacturer_datasheet"
                },
                "publicationBasis": {
                  "enum": [
                    "public_facts",
                    "licensed_redistribution"
                  ]
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "manufacturer_product_page"
                },
                "publicationBasis": {
                  "enum": [
                    "public_facts",
                    "licensed_redistribution"
                  ]
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "independent_measurement"
                },
                "publicationBasis": {
                  "const": "original_measurement"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "authored_derivation"
                },
                "publicationBasis": {
                  "enum": [
                    "public_facts",
                    "licensed_redistribution"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceId",
            "locator",
            "retrievedAt",
            "contentHash",
            "licenseNote",
            "kind",
            "url",
            "revision",
            "publicationBasis"
          ],
          "properties": {
            "sourceId": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "licenseNote": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "retrievedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contentHash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "const": "synthetic_fixture"
            },
            "url": {
              "type": "null"
            },
            "revision": {
              "type": "null"
            },
            "publicationBasis": {
              "type": "null"
            }
          }
        }
      ]
    },
    "operatingRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameterId",
        "minimum",
        "maximum",
        "evidence"
      ],
      "properties": {
        "parameterId": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit",
                "displayUnit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "$ref": "https://schemas.schemagic.design/design-library/v1/profile-envelope.v1.schema.json#/$defs/profileUnit"
                },
                "displayUnit": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit",
                "displayUnit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "$ref": "https://schemas.schemagic.design/design-library/v1/profile-envelope.v1.schema.json#/$defs/profileUnit"
                },
                "displayUnit": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "minimum": {
              "not": {
                "type": "null"
              }
            }
          }
        },
        {
          "properties": {
            "maximum": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "profileFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "state",
        "evidence",
        "validFor",
        "explanation"
      ],
      "properties": {
        "value": {},
        "state": {
          "enum": [
            "reviewed",
            "calculated",
            "estimated",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "validFor": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operatingRange"
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "state": {
                "const": "unknown"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "value": {
                "type": "null"
              },
              "evidence": {
                "type": "array",
                "maxItems": 0
              },
              "validFor": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "factText": {
      "allOf": [
        {
          "$ref": "#/$defs/profileFact"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "factBoolean": {
      "allOf": [
        {
          "$ref": "#/$defs/profileFact"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}
