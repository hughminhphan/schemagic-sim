{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.schemagic.design/design-library/v1/profile-envelope.facts-v3.schema.json",
  "title": "scheMAGIC design profile envelope with facts schema V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "partClass",
    "part",
    "factsSchemaVersion",
    "commonFacts",
    "facts"
  ],
  "properties": {
    "format": {
      "const": "schemagic-design-profile"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "partClass": {
      "enum": [
        "shared.n-channel-power-mosfet",
        "motor.supply-tvs-diode"
      ]
    },
    "part": {
      "$ref": "https://schemas.schemagic.design/design-library/v1/profile-envelope.v1.schema.json#/$defs/part"
    },
    "factsSchemaVersion": {
      "const": "3.0.0"
    },
    "commonFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "boardArea",
        "maximumHeight"
      ],
      "properties": {
        "packageName": {
          "$ref": "https://schemas.schemagic.design/design-library/v1/profile-envelope.v1.schema.json#/$defs/factText"
        },
        "boardArea": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "state",
            "evidence",
            "validFor",
            "explanation"
          ],
          "properties": {
            "value": {
              "type": "null"
            },
            "state": {
              "const": "unknown"
            },
            "evidence": {
              "type": "array",
              "maxItems": 0
            },
            "validFor": {
              "type": "array",
              "maxItems": 0
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            }
          }
        },
        "maximumHeight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "state",
            "evidence",
            "validFor",
            "explanation"
          ],
          "properties": {
            "value": {
              "type": "null"
            },
            "state": {
              "const": "unknown"
            },
            "evidence": {
              "type": "array",
              "maxItems": 0
            },
            "validFor": {
              "type": "array",
              "maxItems": 0
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    },
    "facts": {
      "type": "object"
    }
  },
  "$defs": {
    "mountedGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boardArea",
        "maximumHeight"
      ],
      "properties": {
        "boardArea": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "state",
            "evidence",
            "validFor",
            "explanation"
          ],
          "properties": {
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "area",
                "basis",
                "calculation",
                "sourceDimensions"
              ],
              "properties": {
                "area": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "unit",
                    "displayUnit"
                  ],
                  "properties": {
                    "value": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "unit": {
                      "const": "m2"
                    },
                    "displayUnit": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    }
                  }
                },
                "basis": {
                  "enum": [
                    "manufacturer_recommended_land_pattern_bounding_box",
                    "reviewed_assembly_footprint_bounding_box"
                  ]
                },
                "calculation": {
                  "const": "maximum_x_span_times_maximum_y_span"
                },
                "sourceDimensions": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "axis",
                      "dimensionId",
                      "multiplier",
                      "maximum",
                      "evidence"
                    ],
                    "properties": {
                      "axis": {
                        "enum": [
                          "x",
                          "y"
                        ]
                      },
                      "dimensionId": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                      },
                      "multiplier": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "maximum": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "value",
                          "unit",
                          "displayUnit"
                        ],
                        "properties": {
                          "value": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "unit": {
                            "const": "m"
                          },
                          "displayUnit": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": ".*\\S.*"
                          }
                        }
                      },
                      "evidence": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "https://schemas.schemagic.design/design-library/v1/profile-envelope.v1.schema.json#/$defs/evidence"
                        }
                      }
                    }
                  }
                }
              }
            },
            "state": {
              "const": "calculated"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "https://schemas.schemagic.design/design-library/v1/profile-envelope.v1.schema.json#/$defs/evidence"
              }
            },
            "validFor": {
              "type": "array",
              "maxItems": 0
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            }
          }
        },
        "maximumHeight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "state",
            "evidence",
            "validFor",
            "explanation"
          ],
          "properties": {
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "height",
                "basis"
              ],
              "properties": {
                "height": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "unit",
                    "displayUnit"
                  ],
                  "properties": {
                    "value": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "unit": {
                      "const": "m"
                    },
                    "displayUnit": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    }
                  }
                },
                "basis": {
                  "enum": [
                    "manufacturer_package_maximum_in_surface_mount_orientation",
                    "reviewed_assembly_envelope_maximum"
                  ]
                }
              }
            },
            "state": {
              "const": "reviewed"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "https://schemas.schemagic.design/design-library/v1/profile-envelope.v1.schema.json#/$defs/evidence"
              }
            },
            "validFor": {
              "type": "array",
              "maxItems": 0
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    }
  }
}
