      "scalar_checks": [
        {
          "name": "output_voltage_10ma",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "last(v(out))"
          },
          "expected_value": 5,
          "unit": "V",
          "tolerance": {
            "absolute": 0.05,
            "relative": 0.01
          },
          "datasheet_citation": "p. 5 Section 7.5, LM1117-5.0 Output voltage MIN/TYP/MAX row",
          "placeholder": false
        },
        {
          "name": "input_current_including_iq",
          "expression_source": {
