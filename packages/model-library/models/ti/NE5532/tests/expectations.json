          },
          "expected_value": -0.2495,
          "unit": "V",
          "tolerance": {
            "absolute": 0.01,
            "relative": 0.03
          },
          "datasheet_citation": "p. 4, Section 5.5 Electrical Characteristics, VIO row, TYP column; p. 3, Section 5.3 Recommended Operating Conditions",
          "placeholder": false
        },
        {
          "name": "minimum_supply_follow_zero",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "last(v(oz))"
          },
          "expected_value": 0.0005,
          "unit": "V",
          "tolerance": {
            "absolute": 0.01,
            "relative": 0.03
          },
          "datasheet_citation": "p. 4, Section 5.5 Electrical Characteristics, VIO row, TYP column; p. 3, Section 5.3 Recommended Operating Conditions",
          "placeholder": false
        },
        {
          "name": "minimum_supply_follow_positive",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "last(v(op))"
          },
          "expected_value": 0.2505,
          "unit": "V",
          "tolerance": {
            "absolute": 0.01,
            "relative": 0.03
          },
          "datasheet_citation": "p. 4, Section 5.5 Electrical Characteristics, VIO row, TYP column; p. 3, Section 5.3 Recommended Operating Conditions",
          "placeholder": false
        }
      ],
      "hard_bounds_checks": []
    },
    {
      "test_netlist": "short_circuit.cir",
      "analysis_type": "operating_point",
      "scalar_checks": [
        {
          "name": "short_circuit_current",
          "expression_source": {
            "kind": "raw_variable",
