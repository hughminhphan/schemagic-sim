          "name": "common_mode_gain",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "magnitude:last(v(out))"
          },
          "expected_value": 1.0,
          "unit": "V/V",
          "tolerance": {
            "absolute": 0,
            "relative": 0.3
          },
          "datasheet_citation": "p. 4, Section 5.5 Electrical Characteristics, CMRR row, TYP column",
