OpenCircuit factory test: LM324 falling_slew.cir
* OpenCircuit Model Factory v0.1.0
* Original work generated from public factual specifications.
* This model is not a copy of, or adaptation from, any vendor SPICE model.
* Source: https://www.ti.com/lit/ds/symlink/lm324.pdf
* Revision: SLOS066AE, August 1975, revised September 2025
* Fit: exactly three native ngspice-46 fixed-point calibration iterations
* Node order: INP INN VCC VEE OUT
.subckt OC_TI_LM324 INP INN VCC VEE OUT
.param AOL=1.0000000000e5 GBW=1.3239453708e6 SR=5.3001242052e5 IBIAS=2.0000000000e-8 IOS=2.0000000000e-9 VOS=3.0000000000e-3
.param ROUT=5.0000000000e1 ILIM=4.0000000000e-2 VDRP_H=1.9349780511e0 VDRP_L=1.0000000000e-2 CC=30p FP2=3.9718361124e6
.param CMRR=1.0000000000e4 PSRR=1.0000000000e5 VSUP_NOM=5.0000000000e0 IQ=1.7500000000e-4 EN=3.5000000000e-8
IBP 0 INP DC {IBIAS+IOS/2}
IBN 0 INN DC {IBIAS-IOS/2}
CDIF INP INN 1p
BERR e 0 V = v(INP,INN) + VOS + v(nz) + 0.5*(v(INP)+v(INN))/CMRR + (v(VCC,VEE)-VSUP_NOM)/PSRR
RE e 0 1meg
RNZ nz 0 {EN*EN/(4*1.380649e-23*300.15)}
BGM 0 p I = {SR*CC}*tanh({6.283185307*GBW/SR}*v(e))
CP p 0 {CC}
RP p 0 {AOL/(6.283185307*GBW*CC)}
RP2 p p2 {1/(6.283185307*FP2*1p)}
CP2 p2 0 1p
BCLMP q 0 V = min(max(v(p2), v(VEE)+min(VDRP_L,0.49*v(VCC,VEE))), v(VCC)-min(VDRP_H,0.49*v(VCC,VEE)))
RQ q 0 1meg
BOUT 0 OUT I = ILIM*tanh((v(q)-v(OUT))/(ROUT*ILIM))
IQVCC VCC VEE DC {IQ}
.ends OC_TI_LM324

.temp 25
VCC vcc 0 DC 5
VEE vee 0 DC 0
VIN sig 0 PULSE(2.5 0.5 1u 1n 1n 20u 40u)
X1 sig out vcc vee out OC_TI_LM324
RL out 0 1Meg
.tran 5n 25u
.end
