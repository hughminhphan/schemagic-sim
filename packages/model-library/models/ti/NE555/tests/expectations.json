{
  "schema_version": "1.0.0",
  "tests": [
    {
      "test_netlist": "astable.cir",
      "analysis_type": "transient",
      "scalar_checks": [
        {
          "name": "astable_frequency",
          "expression_source": {
            "kind": "derived_expression",
            "expression": "frequency_from_edges(v(out),1.7,rising,2,4)"
          },
          "expected_value": 4800.0,
          "unit": "Hz",
          "tolerance": {
            "absolute": 0,
            "relative": 0.05
          },
          "datasheet_citation": "TI NE555 SLFS022K p. 12 Eq. 4 and Eq. 6",
          "placeholder": false
        },
        {
          "name": "astable_output_high_duty_cycle",
          "expression_source": {
            "kind": "derived_expression",
            "expression": "duty_cycle_from_edges(v(out),1.7,rising,2,falling,3,rising,3)"
          },
          "expected_value": 0.6666666666666666,
          "unit": "1",
          "tolerance": {
            "absolute": 0,
            "relative": 0.05
          },
          "datasheet_citation": "TI NE555 SLFS022K p. 12 Eq. 4 and Eq. 6",
          "placeholder": false
        }
      ],
      "hard_bounds_checks": []
