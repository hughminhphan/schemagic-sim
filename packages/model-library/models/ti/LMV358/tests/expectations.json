      "analysis_type": "ac_small_signal",
      "scalar_checks": [
        {
          "name": "open_loop_gain_db",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "db:first(v(out))"
          },
          "expected_value": 100.0,
          "unit": "dB",
          "tolerance": {
            "absolute": 0.7,
            "relative": 0
          },
          "datasheet_citation": "p. 7, Section 6.8 Electrical Characteristics, AVD row, TYP column",
          "placeholder": false
        },
        {
          "name": "unity_gain_bandwidth",
