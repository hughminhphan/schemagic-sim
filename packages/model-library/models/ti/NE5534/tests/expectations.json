{
  "schema_version": "1.0.0",
  "tests": [
    {
      "test_netlist": "open_loop_gain.cir",
      "analysis_type": "ac_small_signal",
      "scalar_checks": [
        {
          "name": "open_loop_gain_db",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "db:first(v(out))"
          },
          "expected_value": 100,
          "unit": "dB",
          "tolerance": {
            "absolute": 0.6,
            "relative": 0
          },
          "datasheet_citation": "p. 5 open-loop gain TYP",
          "placeholder": false
        },
        {
          "name": "unity_gain_bandwidth",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "frequency_at_magnitude(v(out),1)"
          },
          "expected_value": 10000000,
          "unit": "Hz",
          "tolerance": {
            "absolute": 0,
            "relative": 0.2
          },
          "datasheet_citation": "p. 6 AC characteristics",
          "placeholder": false
        }
      ],
      "hard_bounds_checks": []
    },
    {
      "test_netlist": "offset_and_bias.cir",
      "analysis_type": "operating_point",
      "scalar_checks": [
        {
          "name": "input_offset",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "scale:last(v(out2),0.1)"
          },
          "expected_value": 0.0005,
          "unit": "V",
          "tolerance": {
            "absolute": 0.0001,
            "relative": 2
          },
          "datasheet_citation": "p. 5 input offset TYP",
          "placeholder": false
        },
        {
          "name": "input_bias_positive",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "abs:last(i(vp1))"
          },
          "expected_value": 5.1e-7,
          "unit": "A",
          "tolerance": {
            "absolute": 1e-13,
            "relative": 0.05
          },
          "datasheet_citation": "p. 5 input bias TYP",
          "placeholder": false
        },
        {
          "name": "input_bias_negative",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "abs:last(i(vn1))"
          },
          "expected_value": 4.9e-7,
          "unit": "A",
          "tolerance": {
            "absolute": 1e-13,
            "relative": 0.05
          },
          "datasheet_citation": "p. 5 input bias TYP",
          "placeholder": false
        }
      ],
      "hard_bounds_checks": []
    },
    {
