          "expected_value": 0.6666666666666666,
          "unit": "1",
          "tolerance": {
            "absolute": 0,
            "relative": 0.05
          },
          "datasheet_citation": "TI LMC555 SNAS558N p. 11 Eq. 4 and Eq. 5",
          "placeholder": false
