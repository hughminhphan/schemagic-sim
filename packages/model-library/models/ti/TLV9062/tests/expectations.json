{
  "schema_version": "1.0.0",
  "tests": [
    {
      "test_netlist": "open_loop_gain.cir",
      "analysis_type": "ac_small_signal",
      "scalar_checks": [
        {
          "name": "open_loop_gain_db",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "db:first(v(out))"
          },
          "expected_value": 130.0,
          "unit": "dB",
          "tolerance": {
            "absolute": 0.7,
            "relative": 0
          },
          "datasheet_citation": "p. 13, Section 6.10 Electrical Characteristics, AOL row, RL = 2 kohm, TYP column",
          "placeholder": false
        },
        {
          "name": "unity_gain_bandwidth",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "frequency_at_magnitude(v(out),1)"
          },
          "expected_value": 10000000.0,
          "unit": "Hz",
          "tolerance": {
            "absolute": 0,
            "relative": 0.2
          },
          "datasheet_citation": "p. 13, Section 6.10 Electrical Characteristics, GBP row, TYP column",
          "placeholder": false
        }
      ],
      "hard_bounds_checks": []
    },
