OpenCircuit LM4562 slew rate
* OpenCircuit Model Factory v0.1.0
* Original work generated from public factual specifications.
* This model is not a copy of, or adaptation from, any vendor SPICE model.
* Node order: INP INN VCC VEE OUT
.subckt OC_TI_LM4562 INP INN VCC VEE OUT
.param AOL=1.0000000000e+07 GBW=5.9653988328e+07 SR=2.0824454881e+07 IBIAS=1.0000000000e-08 IOS=1.1000000000e-08 VOS=1.0000000000e-04
.param ROUT=1.3000000000e+01 ILIM=4.2000000000e-02 VDRP_H=9.0814336381e-01 VDRP_L=9.0814323582e-01 CC=30p FP2=1.7896196498e+08
.param CMRR=1.0000000000e+06 PSRR=1.0000000000e+06 VSUP_NOM=3.0000000000e+01 IQ=5.0000000000e-03 EN=2.7000000000e-09
IBP 0 INP DC {IBIAS+IOS/2}
IBN 0 INN DC {IBIAS-IOS/2}
CDIF INP INN 1p
BERR e 0 V = v(INP,INN) + VOS + v(nz) + 0.5*(v(INP)+v(INN))/CMRR + (v(VCC,VEE)-VSUP_NOM)/PSRR
RE e 0 1meg
RNZ nz 0 {EN*EN/(4*1.380649e-23*300.15)}
BGM 0 p I = {SR*CC}*tanh({6.283185307*GBW/SR}*v(e))
CP p 0 {CC}
RP p 0 {AOL/(6.283185307*GBW*CC)}
RP2 p p2 {1/(6.283185307*FP2*1p)}
CP2 p2 0 1p
BCLMP q 0 V = min(max(v(p2), v(VEE)+min(VDRP_L,0.49*v(VCC,VEE))), v(VCC)-min(VDRP_H,0.49*v(VCC,VEE)))
RQ q 0 1meg
BOUT 0 OUT I = ILIM*tanh((v(q)-v(OUT))/(ROUT*ILIM))
IQVCC VCC VEE DC {IQ}
.ends OC_TI_LM4562

.temp 25
VCC vcc 0 DC 15
VEE vee 0 DC -15
VMID mid 0 DC 0.0
VIN sig 0 PULSE(-6.0 6.0 1u 1n 1n 1e-05 2e-05)
X1 sig out vcc vee out OC_TI_LM4562
