          "expected_value": 0.005,
          "unit": "A",
          "tolerance": {
            "absolute": 1e-08,
            "relative": 0.1
          },
          "datasheet_citation": "p. 4, Electrical Characteristics, IS row, TYP column",
          "placeholder": false
        }
      ],
      "hard_bounds_checks": []
    },
