{
  "schema_version": "1.0.0",
  "tests": [
    {
      "test_netlist": "open_loop_gain.cir",
      "analysis_type": "ac_small_signal",
      "scalar_checks": [
        {
          "name": "open_loop_gain_db",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "db:first(v(out))"
          },
          "expected_value": 140.0,
          "unit": "dB",
          "tolerance": {
            "absolute": 0.7,
            "relative": 0
          },
          "datasheet_citation": "p. 3, Electrical Characteristics, AVOL row, RL = 2 kohm, TYP column",
          "placeholder": false
        },
        {
          "name": "unity_gain_bandwidth",
          "expression_source": {
            "kind": "raw_variable",
            "expression": "frequency_at_magnitude(v(out),1)"
          },
          "expected_value": 55000000.0,
          "unit": "Hz",
          "tolerance": {
            "absolute": 0,
            "relative": 0.2
          },
          "datasheet_citation": "p. 3, Electrical Characteristics, GBWP row, TYP column",
          "placeholder": false
        }
      ],
      "hard_bounds_checks": []
    },
