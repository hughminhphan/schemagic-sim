.subckt OC_NEXPERIA_74HC74_OUT IN Y VCC GND
BDRV yd GND V = min(max(v(IN)*v(VCC,GND),0),v(VCC,GND))
RDRV yd Y R={37.5+(45.0-37.5)*0.5*(1+tanh(12*(v(IN)-0.5)))}
.ends OC_NEXPERIA_74HC74_OUT
.subckt OC_NEXPERIA_74HC74_DFF D CLK Q QB SETN CLRN VCC GND
+ PARAMS: KIN=20 KREG=25 TAU=2.1400000000e-08 VSKEW=0.05
RID D GND 1e11
RIC CLK GND 1e11
RISET SETN GND 1e11
RICLR CLRN GND 1e11
BC c GND V = 0.5*(1+tanh(KIN*(v(CLK,GND)/v(VCC,GND)-0.5)))
BD dd GND V = 0.5*(1+tanh(KIN*(v(D,GND)/v(VCC,GND)-0.5)))
BSET st GND V = 0.5*(1+tanh(KIN*(v(SETN,GND)/v(VCC,GND)-0.5)))
BCLR cl GND V = 0.5*(1+tanh(KIN*(v(CLRN,GND)/v(VCC,GND)-0.5)))
BMA mad GND V = (v(cl)<0.5) ? ((v(st)<0.5) ? 1 : 0) : ((v(st)<0.5) ? 1 : ((v(c)<0.5) ? v(dd) : 0.5*(1-tanh(KREG*(v(mb)-0.5)))))
RMA mad ma {TAU/1p}
CMA ma GND 1p
BMB mbd GND V = (v(cl)<0.5) ? 1 : ((v(st)<0.5) ? ((v(cl)<0.5) ? 1 : 0) : 0.5*(1-tanh(KREG*(v(ma)-0.5))) + VSKEW)
RMB mbd mb {TAU/1p}
CMB mb GND 1p
BSA sad GND V = (v(cl)<0.5) ? ((v(st)<0.5) ? 1 : 0) : ((v(st)<0.5) ? 1 : ((v(c)>0.5) ? v(ma) : 0.5*(1-tanh(KREG*(v(sb)-0.5)))))
RSA sad sa {TAU/1p}
CSA sa GND 1p
BSB sbd GND V = (v(cl)<0.5) ? 1 : ((v(st)<0.5) ? ((v(cl)<0.5) ? 1 : 0) : 0.5*(1-tanh(KREG*(v(sa)-0.5))) + VSKEW)
RSB sbd sb {TAU/1p}
CSB sb GND 1p
XQ sa Q VCC GND OC_NEXPERIA_74HC74_OUT
XQB sb QB VCC GND OC_NEXPERIA_74HC74_OUT
.ends OC_NEXPERIA_74HC74_DFF
.subckt OC_NEXPERIA_74HC74 D CLK Q QB SD RD VCC GND
XFF D CLK Q QB SD RD VCC GND OC_NEXPERIA_74HC74_DFF
.ends OC_NEXPERIA_74HC74
.temp 25
VCC vcc 0 4.5
VSD sd 0 4.5
VRD rd 0 4.5
VCK ck 0 PULSE(0 4.5 0.1u 3n 3n 0.5u 1u)
X1 qb ck q qb sd rd vcc 0 OC_NEXPERIA_74HC74
CQ q 0 15p
CQB qb 0 15p
.save v(ck) v(q) v(qb)
.tran 0.2n 5u
.measure tran q_period TRIG v(q) VAL=2.25 RISE=1 TARG v(q) VAL=2.25 RISE=2
