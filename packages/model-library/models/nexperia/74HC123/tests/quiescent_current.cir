RIrn RD GND 1e11
BIrn rn GND V = 0.5*(1+tanh(20*(v(RD,GND)/v(VCC,GND)-0.5)))
BTRIG tr GND V = (1-v(an))*v(bn)*v(rn)
BCMP rs GND V = 0.5*(1+tanh(30*(v(REXT_CEXT,GND)/v(VCC,GND)-VTH))) + (1-v(rn))
