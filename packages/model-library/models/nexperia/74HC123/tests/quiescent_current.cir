RDRV yd Y R={37.5+(45.0-37.5)*0.5*(1+tanh(12*(v(IN)-0.5)))}
.ends OC_NEXPERIA_74HC123_OUT
.subckt OC_NEXPERIA_74HC123 ABAR B RD Q QB CEXT REXT_CEXT VCC GND
+ PARAMS: KIN=20 KREG=25 TAU=1.2000000000e-08 VSKEW=0.05 VTH=0.362372
RIan ABAR GND 1e11
