RSB sbd sb {TAU/1p}
CSB sb GND 1p
XQ sa Q VCC GND OC_NEXPERIA_74HC123_OUT
XQB sb QB VCC GND OC_NEXPERIA_74HC123_OUT
RICE CEXT GND 1e11
RDIS REXT_CEXT GND R={1/(0.1*(1-v(sa))+1e-9*v(sa))}
.ends OC_NEXPERIA_74HC123
