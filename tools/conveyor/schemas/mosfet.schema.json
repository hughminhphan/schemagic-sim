                  "minLength": 1
                },
                "conditions": {
                  "type": "string",
                  "minLength": 1
                },
                "page_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "object"
                },
                "source_kind": {
                  "enum": [
                    "minimum",
                    "typical",
                    "maximum",
                    "digitized_typical_curve"
                  ]
