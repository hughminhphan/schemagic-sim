{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "scalar_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "table",
        "row"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "voltage_coordinate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value_v"
          ],
          "properties": {
            "kind": {
              "const": "fixed"
            },
            "value_v": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "relation"
          ],
          "properties": {
            "kind": {
              "const": "relation"
            },
            "relation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lower_v",
            "upper_v"
          ],
          "properties": {
            "kind": {
              "const": "range"
            },
            "lower_v": {
              "type": "number"
            },
            "upper_v": {
              "type": "number"
            }
          }
        }
      ]
    },
    "current_coordinate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value_a"
          ],
          "properties": {
            "kind": {
              "const": "fixed"
            },
            "value_a": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lower_a",
            "upper_a"
          ],
          "properties": {
            "kind": {
              "const": "range"
            },
            "lower_a": {
              "type": "number"
            },
            "upper_a": {
              "type": "number"
            }
          }
        }
      ]
    },
    "condition_temperature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "kind",
        "value_c",
        "provenance"
      ],
      "properties": {
        "status": {
          "const": "stated"
        },
        "kind": {
          "enum": [
            "ambient",
            "case",
            "junction"
          ]
        },
        "value_c": {
          "type": "number"
        },
        "provenance": {
          "enum": [
            "inline_condition",
            "table_heading",
            "figure_label",
            "footnote",
            "section_scope"
          ]
        }
      }
    },
    "condition_test_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "dc",
            "continuous",
            "pulsed",
            "single_pulse",
            "not_stated"
          ]
        },
        "pulse_width_s": {
          "type": "number"
        },
        "duty_cycle": {
          "type": "number"
        },
        "repetition_period_s": {
          "type": "number"
        },
        "repetition_frequency_hz": {
          "type": "number"
        }
      }
    },
    "direct_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "polarity",
        "magnitude_convention",
        "temperature",
        "electrical",
        "test_mode"
      ],
      "properties": {
        "polarity": {
          "enum": [
            "n",
            "p"
          ]
        },
        "magnitude_convention": {
          "enum": [
            "signed",
            "absolute"
          ]
        },
        "temperature": {
          "$ref": "#/$defs/condition_temperature"
        },
        "electrical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vgs",
            "vds",
            "id"
          ],
          "properties": {
            "vgs": {
              "$ref": "#/$defs/voltage_coordinate"
            },
            "vds": {
              "$ref": "#/$defs/voltage_coordinate"
            },
            "id": {
              "$ref": "#/$defs/current_coordinate"
            }
          }
        },
        "test_mode": {
          "$ref": "#/$defs/condition_test_mode"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mpn",
    "manufacturer",
    "family",
    "datasheet_identity",
    "usable_curves",
    "curves",
    "specs",
    "extraction_notes",
    "omission_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "mpn": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "const": "mosfet"
    },
    "datasheet_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "revision",
        "pages_examined"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "pages_examined": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "usable_curves": {
      "type": "boolean"
    },
    "curves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "x_axis",
          "y_axis",
          "test_conditions",
          "page_reference",
          "locator",
          "temperature",
          "electrical_bias",
          "test_mode",
          "magnitude_convention",
          "points"
