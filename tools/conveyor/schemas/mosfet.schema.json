        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "x_axis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantity",
              "unit",
              "scale"
            ],
            "properties": {
              "quantity": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "scale": {
