              "type": "object",
              "additionalProperties": false,
              "required": [
                "quantity",
                "value",
                "unit"
              ],
              "properties": {
                "quantity": {
                  "enum": [
                    "VGS",
                    "V_GS",
                    "VDS",
                    "V_DS",
                    "ID",
                    "I_D",
                    "vgs",
                    "v_gs",
                    "vds",
                    "v_ds",
                    "id",
                    "i_d"
                  ]
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "test_mode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "dc",
                  "continuous",
                  "pulsed",
                  "single_pulse",
                  "not_stated"
