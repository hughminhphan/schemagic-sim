{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mpn",
    "manufacturer",
    "family",
    "datasheet_identity",
    "usable_curves",
    "curves",
    "specs",
    "extraction_notes",
    "omission_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "mpn": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "const": "mosfet"
    },
    "datasheet_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "revision",
        "pages_examined"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "pages_examined": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "usable_curves": {
      "type": "boolean"
    },
    "curves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "x_axis",
          "y_axis",
          "test_conditions",
          "page_reference",
          "locator",
          "temperature",
          "electrical_bias",
          "test_mode",
          "points"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "x_axis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantity",
              "unit",
              "scale"
            ],
            "properties": {
              "quantity": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "scale": {
                "enum": [
                  "linear",
                  "log"
                ]
              }
            }
          },
          "y_axis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantity",
              "unit",
              "scale"
            ],
            "properties": {
              "quantity": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "scale": {
                "enum": [
                  "linear",
                  "log"
                ]
              }
            }
          },
          "test_conditions": {
            "type": "string",
            "minLength": 1
          },
          "page_reference": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "figure",
              "curve_or_trace"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "figure": {
                "type": "string",
                "minLength": 1
              },
              "curve_or_trace": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "temperature": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value",
              "provenance"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "ambient",
                  "case",
                  "junction"
                ]
              },
              "value": {
                "type": "number"
              },
              "provenance": {
                "enum": [
                  "inline_condition",
                  "table_heading",
                  "figure_label",
                  "footnote",
                  "section_scope"
                ]
              }
            }
          },
          "electrical_bias": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quantity",
                "value",
                "unit"
              ],
              "properties": {
                "quantity": {
                  "enum": [
                    "VGS",
                    "V_GS",
                    "VDS",
                    "V_DS",
                    "ID",
                    "I_D",
                    "vgs",
                    "v_gs",
                    "vds",
                    "v_ds",
                    "id",
                    "i_d"
                  ]
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "test_mode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "dc",
                  "continuous",
                  "pulsed",
                  "single_pulse",
                  "not_stated"
                ]
              },
              "pulse_width_s": {
                "type": "number"
              },
              "duty_cycle": {
                "type": "number"
              },
              "repetition_frequency_hz": {
                "type": "number"
              }
            }
          },
          "points": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "specs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "polarity",
        "threshold_min",
        "threshold_typ",
        "threshold_max",
        "rdson_points",
        "ciss",
        "coss",
        "crss",
        "breakdown_voltage",
        "body_diode"
      ],
      "properties": {
        "polarity": {
          "enum": [
            "n",
            "p"
          ]
        },
        "threshold_min": {
          "anyOf": [
