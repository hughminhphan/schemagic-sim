              },
              "duty_cycle": {
                "type": "number"
              },
              "repetition_period_s": {
                "type": "number"
              },
              "repetition_frequency_hz": {
                "type": "number"
              }
            }
          },
          "magnitude_convention": {
            "enum": [
              "signed",
              "absolute"
            ]
          },
          "points": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
