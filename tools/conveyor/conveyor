import argparse
import json
import subprocess
import sys
from collections import Counter
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO_ROOT = HERE.parent.parent
FEEDER_ROOT = HERE.parent / "part-feeder"
sys.path.insert(0, str(HERE))
sys.path.insert(0, str(FEEDER_ROOT))

from conveyorlib import (DEFAULT_LUNA_CAP, MAX_LUNA_CAP, ConveyorError, ExtractionCoordinator,
                         StateStore, build_luna_prompt, choose_balanced, filter_library_collisions,
                         json_dump, safe_stem, should_park_family, top_failure_reasons,
                         top_recorded_reasons)
from feederlib import download_datasheets, query_manifest, reviewed_mpns, validate_manifest

DEFAULT_DATA = HERE / "data"
DEFAULT_CATALOG_DATA = Path("/Users/hughp/Documents/opencircuit/tools/part-feeder/data")
DEFAULT_QUERY = HERE / "queries" / "proving-50.sql"
FACTORY = HERE.parent / "model-factory" / "factory.mjs"


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="conveyor", description="Bulk fit SQL-selected discrete tranches into unreviewed staging")
    root.add_argument("--data-dir", type=Path, default=DEFAULT_DATA)
    root.add_argument("--catalog-data", type=Path, default=DEFAULT_CATALOG_DATA, help="external jlcparts data opened read-only")
    commands = root.add_subparsers(dest="command", required=True)
    select = commands.add_parser("select", help="select a balanced high-stock tranche from read-only SQL")
    select.add_argument("--name", default="proving-50")
    select.add_argument("--sql-file", type=Path, default=DEFAULT_QUERY)
    select.add_argument("--stock-min", type=int, default=10000)
    fetch = commands.add_parser("fetch", help="rate-limited resumable datasheet acquisition")
    fetch.add_argument("manifest", type=Path)
    fetch.add_argument("--rate", type=float, default=0.5)
    fetch.add_argument("--retries", type=int, default=4)
    jobs = commands.add_parser("jobs", help="write immutable coordinator-backed Luna extraction records")
    jobs.add_argument("manifest", type=Path)
    jobs.add_argument("--max-concurrency", type=int, default=DEFAULT_LUNA_CAP,
                      help=f"recorded live Luna cap (default {DEFAULT_LUNA_CAP}, hard maximum {MAX_LUNA_CAP})")
    extract = commands.add_parser("extract", help="run coordinator validation and publication for job responses")
    extract.add_argument("manifest", type=Path)
    extract.add_argument("--jobs-file", type=Path)
    extract.add_argument("--response-dir", type=Path,
                         help="producer directory containing <lcsc-id>.json or <lcsc-id>__<mpn>.json")
    extract.add_argument("--max-concurrency", type=int, default=DEFAULT_LUNA_CAP)
    ingest = commands.add_parser("ingest", help="delegate one response through coordinator validation/publication")
    ingest.add_argument("manifest", type=Path)
    ingest.add_argument("--lcsc-id", required=True)
    ingest.add_argument("--response", type=Path, required=True)
    fit = commands.add_parser("fit", help="run the factory bulk adapter and stage pending-review packages")
    fit.add_argument("manifest", type=Path)
    fit.add_argument("--no-park", action="store_true", help="disable the family circuit breaker so every part records its own fit evidence (proving runs)")
    fit.add_argument("--park-after", type=int, default=2, help="consecutive F2 gate failures, with no F2 success in the family, before parking")
    fit.add_argument("--regenerate-staged", action="store_true", help="rebuild already staged packages from preserved extraction JSON")
    status = commands.add_parser("status", help="show state and fidelity counts")
    status.add_argument("manifest", type=Path)
    return root


def tranche_name(manifest_path: Path) -> str:
    return safe_stem(manifest_path.stem)


def state_store(data_dir: Path) -> StateStore:
    return StateStore(data_dir / "conveyor-state.sqlite3")


def load_manifest(path: Path) -> dict:
    manifest = json.loads(path.read_text(encoding="utf-8"))
    validate_manifest(manifest)
    return manifest


def part_by_id(manifest: dict, lcsc_id: str) -> dict:
    for part in manifest["parts"]:
        if part["lcsc_id"].casefold() == lcsc_id.casefold():
            return part
    raise ConveyorError(f"No manifest part with LCSC ID {lcsc_id}")


def select_command(args) -> int:
    db = args.catalog_data / "jlcparts.sqlite3"
    dump = args.catalog_data / "dump.json"
    if not db.is_file() or not dump.is_file():
        raise ConveyorError(f"External catalog data is incomplete: {args.catalog_data}")
    sql = args.sql_file.read_text(encoding="utf-8")
    source_state = json.loads(dump.read_text(encoding="utf-8"))
    library_root = REPO_ROOT / "packages" / "model-library" / "models"
    raw = query_manifest(db, sql, {"stock_min": args.stock_min}, source_state,
                         library_root, f"sql-file:{args.sql_file.name}", limit=None,
                         exclude_reviewed=False)
    eligible, collision_skips = filter_library_collisions(raw["parts"], library_root)
    balanced = choose_balanced(eligible)
    manifest = {**raw, "parts": balanced, "part_count": len(balanced), "selection_skips": collision_skips}
    manifest["query"]["exclude_reviewed"] = True
    manifest["query"]["reviewed_mpn_count"] = len(reviewed_mpns(library_root))
    manifest["query"]["family_quotas"] = {"diode": 18, "bjt": 16, "mosfet": 16}
    output = args.data_dir / "tranches" / f"{safe_stem(args.name)}.json"
    json_dump(output, manifest)
    store = state_store(args.data_dir)
    try:
        store.seed(tranche_name(output), balanced)
    finally:
        store.close()
    print(json.dumps({"manifest": str(output), "part_count": len(balanced), "families": dict(Counter(part["conveyor_family"] for part in balanced)), "selection_skips": collision_skips}, indent=2))
    return 0


def fetch_command(args) -> int:
    manifest = load_manifest(args.manifest)
    tranche = tranche_name(args.manifest)
    store = state_store(args.data_dir)
    store.seed(tranche, manifest["parts"])
    report = download_datasheets(args.manifest, args.data_dir, requests_per_second=args.rate, retries=args.retries)
    staged = json.loads((args.data_dir / "staging" / tranche / "manifest.json").read_text(encoding="utf-8"))
    records = {(item["lcsc_id"], item["mpn"]): item for item in staged["datasheets"]}
    try:
        for part in manifest["parts"]:
            row = store.get(tranche, part["lcsc_id"])
            if row["state"] not in {"selected", "failed_datasheet_fetched"}:
                continue
            record = records[(part["lcsc_id"], part["mpn"])]
            if record["status"] in {"downloaded", "cached"}:
                store.transition(tranche, part["lcsc_id"], "datasheet_fetched", datasheet_path=record["path"])
            else:
                failure = next((item for item in report["failures"] if item["lcsc_id"] == part["lcsc_id"]), None)
                store.transition(tranche, part["lcsc_id"], "failed_datasheet_fetched", reason=(failure or {}).get("error", "datasheet download failed"))
    finally:
        store.close()
    print(json.dumps(report, indent=2))
    return 0 if report["failed"] == 0 else 2


def jobs_command(args) -> int:
    if args.max_concurrency < 1 or args.max_concurrency > MAX_LUNA_CAP:
        raise ConveyorError(f"Extraction concurrency must be between 1 and {MAX_LUNA_CAP}")
    manifest = load_manifest(args.manifest)
    tranche = tranche_name(args.manifest)
    staging = args.data_dir / "staging" / tranche
    jobs = []
    store = state_store(args.data_dir)
    try:
        for part in manifest["parts"]:
            row = store.get(tranche, part["lcsc_id"])
            if row["state"] not in {"datasheet_fetched", "failed_extracted"}:
                continue
            datasheet = staging / row["datasheet_path"]
            pack = HERE / "context-packs" / f"{part['conveyor_family']}.json"
            discrepancies = [row["reason"]] if row["state"] == "failed_extracted" and row["reason"] else []
            prompt = build_luna_prompt(REPO_ROOT, pack, datasheet.resolve(), part, discrepancies)
            job = {
                "tranche": tranche,
                "lcsc_id": part["lcsc_id"],
                "mpn": part["mpn"],
                "manufacturer": part["manufacturer"],
                "family": part["conveyor_family"],
                "datasheet_path": str(datasheet.resolve()),
                "schema_path": str((HERE / "schemas" / f"{part['conveyor_family']}.schema.json").resolve()),
                "response_path": str((staging / "extractions" / f"{safe_stem(part['lcsc_id'])}__{safe_stem(part['mpn'])}.json").resolve()),
                "prompt": prompt,
                "seed_hints": part.get("seed_hints", []),
            }
            registered = store.register_extraction_job(job)
            jobs.append({**job, "job_key": registered["job_key"], "job_hash": registered["job_hash"]})
    finally:
        store.close()
    output = staging / "extraction-jobs.json"
    json_dump(output, {"schema_version": "1.0.0", "tranche": tranche, "job_count": len(jobs),
                       "max_concurrency": args.max_concurrency,
                       "completion_queue_capacity": 2 * args.max_concurrency, "jobs": jobs})
    print(json.dumps({"jobs": str(output), "job_count": len(jobs),
                      "max_concurrency": args.max_concurrency,
                      "completion_queue_capacity": 2 * args.max_concurrency}, indent=2))
    return 0


def load_jobs_file(path: Path) -> list[dict]:
    document = json.loads(path.read_text(encoding="utf-8"))
    jobs = document.get("jobs")
    if not isinstance(jobs, list):
        raise ConveyorError(f"Extraction jobs file has no jobs array: {path}")
    return jobs


def response_file(response_dir: Path, job: dict) -> Path:
    candidates = [
        response_dir / f"{safe_stem(job['lcsc_id'])}__{safe_stem(job['mpn'])}.json",
        response_dir / f"{safe_stem(job['lcsc_id'])}.json",
    ]
    return next((path for path in candidates if path.is_file()), candidates[0])


def run_coordinator(args, jobs: list[dict], response_for_job) -> tuple[int, list[dict]]:
    def invoke(job):
        path = response_for_job(job)
        return path if path.is_file() else None

    coordinator = ExtractionCoordinator(
        args.data_dir / "conveyor-state.sqlite3", invoke, max_concurrency=args.max_concurrency
    )
    results = coordinator.run(jobs)
    manifest = load_manifest(args.manifest)
    staging = (args.data_dir / "staging" / tranche_name(args.manifest)).resolve()
    store = state_store(args.data_dir)
    try:
        for result in results:
            job = next(item for item in jobs if f"{item['tranche']}:{item['lcsc_id']}" == result["job_key"])
            part = part_by_id(manifest, job["lcsc_id"])
            row = store.get(job["tranche"], job["lcsc_id"])
            if result["status"] == "completed" and row["state"] in {"datasheet_fetched", "failed_extracted"}:
                canonical = Path(job["response_path"]).resolve()
                payload = json.loads(canonical.read_text(encoding="utf-8"))
                demotion = result.get("reason")
                if not demotion and not payload["usable_curves"]:
                    demotion = payload.get("omission_reason") or "datasheet lacks usable curves"
                store.transition(
                    job["tranche"], job["lcsc_id"], "extracted", reason=demotion,
                    extraction_path=str(canonical.relative_to(staging)), fidelity="F1" if demotion else None,
                )
            elif result["status"] in {"retry_missing", "retry_discrepancy", "quarantined"} and row["state"] in {"datasheet_fetched", "failed_extracted"}:
                store.transition(job["tranche"], job["lcsc_id"], "failed_extracted", reason=result.get("reason"))
    finally:
        store.close()
    terminal_failures = sum(result["status"] == "quarantined" for result in results)
    retries = sum(result["status"].startswith("retry_") for result in results)
    return (2 if terminal_failures or retries else 0), results


def extract_command(args) -> int:
    tranche = tranche_name(args.manifest)
    jobs_path = args.jobs_file or args.data_dir / "staging" / tranche / "extraction-jobs.json"
    response_dir = (args.response_dir or jobs_path.parent / "responses").resolve()
    code, results = run_coordinator(args, load_jobs_file(jobs_path), lambda job: response_file(response_dir, job))
    print(json.dumps({"status": "completed" if code == 0 else "attention", "results": results}, indent=2))
    return code


def ingest_command(args) -> int:
    tranche = tranche_name(args.manifest)
    jobs_path = args.data_dir / "staging" / tranche / "extraction-jobs.json"
    jobs = [job for job in load_jobs_file(jobs_path) if job["lcsc_id"].casefold() == args.lcsc_id.casefold()]
    if len(jobs) != 1:
        raise ConveyorError(f"Expected one registered extraction job for {args.lcsc_id}")
    args.max_concurrency = 1
    response = args.response.resolve()
    code, results = run_coordinator(args, jobs, lambda job: response)
    print(json.dumps(results[-1] if results else {"status": "already_completed", "job_key": f"{tranche}:{args.lcsc_id}"}, indent=2))
    return code


def fit_command(args) -> int:
    manifest = load_manifest(args.manifest)
    tranche = tranche_name(args.manifest)
    staging = args.data_dir / "staging" / tranche
    batches = staging / "factory-batches"
    packages_root = staging
    parked_path = staging / "family-parked.json"
    previous_parking = json.loads(parked_path.read_text(encoding="utf-8")) if parked_path.is_file() else {}
    parked: dict[str, str] = dict(previous_parking.get("parked", {}))
    f2_failures = Counter(previous_parking.get("f2_gate_failures", {}))
    # A family that has produced even one F2 has demonstrated the pipeline can fit it, so
    # its later honest F1s are per-part outcomes, not evidence of a systematic failure.
    # Counting every gate failure regardless of successes turned a handful of honest F1s
    # into a whole-family cascade in the first proving run.
    f2_successes = Counter(previous_parking.get("f2_gate_successes", {}))
    results_path = staging / "factory-results.json"
    previous_results = json.loads(results_path.read_text(encoding="utf-8")) if results_path.is_file() else {}
    manifest_id_by_mpn = {part["mpn"]: part["lcsc_id"] for part in manifest["parts"]}
    results_by_id = {(item.get("lcsc_id") or manifest_id_by_mpn.get(item["mpn"])): item for item in previous_results.get("results", [])}
    staged_this_run = 0
    store = state_store(args.data_dir)
    try:
        for part in manifest["parts"]:
            row = store.get(tranche, part["lcsc_id"])
            if row["state"] == "staged" and not args.regenerate_staged:
                continue
            if row["state"] == "failed_fitted" and str(row["reason"] or "").startswith("selection skipped:"):
                continue
            if row["state"] not in {"extracted", "fitted", "failed_fitted", "staged"}:
                continue
            extraction_path = staging / row["extraction_path"] if row["extraction_path"] else None
            f2_candidate = row["fidelity"] != "F1" and part["conveyor_family"] not in parked
            demotion_reason = row["reason"]
            if str(demotion_reason or "").startswith("package regeneration failed;"):
                demotion_reason = (results_by_id.get(part["lcsc_id"]) or {}).get("demotion_reason")
            if f2_candidate:
                demotion_reason = None
            if not f2_candidate and part["conveyor_family"] in parked:
                parking_reason = parked[part["conveyor_family"]]
                demotion_reason = "; ".join(reason for reason in (demotion_reason, parking_reason) if reason)
            batch_part = {**part, "datasheet_path": str((staging / row["datasheet_path"]).resolve()), "extraction_path": str(extraction_path.resolve()) if extraction_path else None, "force_f1": not f2_candidate, "allow_f1_demotion": True, "demotion_reason": demotion_reason}
            batch = {"schema_version": "1.0.0", "kind": "opencircuit-conveyor-batch", "parts": [batch_part]}
            batch_path = batches / f"{safe_stem(part['lcsc_id'])}.json"
            json_dump(batch_path, batch)
            completed = subprocess.run(["node", str(FACTORY), "bulk", "--manifest", str(batch_path), "--staging-root", str(packages_root)], cwd=REPO_ROOT, text=True, capture_output=True, timeout=600)

            def record_factory_failure(reason: str) -> None:
                if row["state"] == "staged":
                    store.transition(
                        tranche,
                        part["lcsc_id"],
                        "staged",
                        reason=f"package regeneration failed; retained prior staged package: {reason}",
                        fidelity=row["fidelity"],
                        package_path=row["package_path"],
                    )
                else:
                    store.transition(tranche, part["lcsc_id"], "failed_fitted", reason=reason)

            if completed.returncode not in {0, 2}:
                record_factory_failure((completed.stderr or completed.stdout).strip())
                continue
            try:
                one = json.loads(completed.stdout)[0]
            except (json.JSONDecodeError, IndexError) as error:
                record_factory_failure(f"factory returned invalid result: {error}")
                continue
            if one["status"] == "skipped":
                reason = f"selection skipped: {one.get('reason', 'candidate rejected by staging guard')}"
                if row["state"] == "staged":
                    store.transition(tranche, part["lcsc_id"], "staged", reason=reason,
                                     fidelity=row["fidelity"], package_path=row["package_path"])
                else:
                    store.transition(tranche, part["lcsc_id"], "failed_fitted", reason=reason)
                results_by_id[part["lcsc_id"]] = one
                continue
            if one["status"] == "failed":
                record_factory_failure(one.get("reason", "factory fit failed"))
                continue
            reason = one.get("demotion_reason") or demotion_reason
            family = part["conveyor_family"]
            if f2_candidate and one["fidelity"] == "F2":
                f2_successes[family] += 1
                f2_failures[family] = 0
            elif f2_candidate:
                f2_failures[family] += 1
                if not args.no_park and should_park_family(f2_successes[family], f2_failures[family], args.park_after):
                    parked[family] = (f"family parked after {f2_failures[family]} consecutive F2 fit-gate failures "
                                      f"with no F2 success; later parts staged F1 ({reason})")
            package_path = str(Path(one["package_path"]).relative_to(staging))
            if row["state"] == "extracted":
                store.transition(tranche, part["lcsc_id"], "fitted", fidelity=one["fidelity"], reason=reason, package_path=package_path)
                store.transition(tranche, part["lcsc_id"], "staged", fidelity=one["fidelity"], reason=reason, package_path=package_path)
            else:
                store.transition(tranche, part["lcsc_id"], "staged", fidelity=one["fidelity"], reason=reason, package_path=package_path)
            results_by_id[part["lcsc_id"]] = one
            staged_this_run += 1
    finally:
        rows = store.rows(tranche)
        store.close()
    results = [results_by_id[part["lcsc_id"]] for part in manifest["parts"] if part["lcsc_id"] in results_by_id]
    json_dump(staging / "family-parked.json", {"schema_version": "1.0.0", "parked": parked, "f2_gate_failures": dict(f2_failures), "f2_gate_successes": dict(f2_successes)})
    json_dump(results_path, {"schema_version": "1.0.0", "results": results})
    print(json.dumps({"staged": staged_this_run, "total_staged": len(results), "fidelity": dict(Counter(item.get("fidelity") for item in results)), "states": dict(Counter(row["state"] for row in rows)), "parked": parked}, indent=2))
    return 0


def status_command(args) -> int:
    tranche = tranche_name(args.manifest)
    store = state_store(args.data_dir)
    try:
        rows = store.rows(tranche)
    finally:
        store.close()
    print(json.dumps({"tranche": tranche, "states": dict(Counter(row["state"] for row in rows)), "fidelity": dict(Counter(row["fidelity"] for row in rows if row["fidelity"])), "top_failure_reasons": top_failure_reasons(rows), "top_recorded_reasons": top_recorded_reasons(rows)}, indent=2))
    return 0


def main(argv=None) -> int:
    args = parser().parse_args(argv)
    # Keep staging and package-path comparisons stable when callers pass a
    # repo-relative data directory from inside the worktree.
    args.data_dir = args.data_dir.resolve()
    args.catalog_data = args.catalog_data.resolve()
    try:
        return {"select": select_command, "fetch": fetch_command, "jobs": jobs_command,
                "extract": extract_command, "ingest": ingest_command, "fit": fit_command,
                "status": status_command}[args.command](args)
    except (ConveyorError, OSError, json.JSONDecodeError, subprocess.SubprocessError) as error:
        print(f"conveyor: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
