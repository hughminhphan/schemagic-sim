{
  "name": "opencircuit-workspace",
  "version": "0.2.0-rc.1",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@opencircuit/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@opencircuit/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:library": "node packages/model-library/validate-library.mjs",
    "require:ngspice": "node scripts/require-ngspice.mjs",
    "verify": "npm run require:ngspice && npm run typecheck && npm test && npm run validate:library && npm run build",
    "audit:performance-budget": "npm exec --workspace=@opencircuit/web -- playwright test --config playwright.budgets.config.ts",
    "audit:designer-runtime": "npm run audit:designer-runtime --workspace=@opencircuit/web",
    "replay:benches": "npm --prefix tools/native-ngspice-reference run replay --"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.7",
    "nanoid": "3.3.18",
    "typescript": "5.9.2"
  }
}
