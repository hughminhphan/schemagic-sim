  "rules": {
    "part_identity": "Every catalog and sourcing join uses ManufacturerPartIdentity { manufacturerId, manufacturerPartNumber }; a manufacturer part number alone is never treated as globally unique.",
    "manufacturer_id": "A stable normalized ManufacturerId is the machine key. Manufacturer display names and distributor spellings are aliases and never replace it.",
    "profile_granularity": "one stable manufacturer ID plus exact manufacturer part number per profile",
    "single_writer": "Every manufacturer-ID and exact-MPN pair must have one owning track before its profile is created.",
    "independent_review": "The review track must differ from the owning track before a profile can become reviewed.",
    "shared_profile_owner": "integration-data-review",
    "reviewed_definition": "Schema-valid engineering facts with primary-source locators, compatible publication rights, declared valid ranges, completed independent review, and all required deterministic checks passing.",
    "simulation_separation": "A reviewed design profile does not imply that a redistributable SPICE model exists or has been reviewed.",
    "manufacturer_neutrality": "Manufacturer identity is display and filter metadata and cannot influence admission or ranking.",
    "unknown_data": "Missing facts remain unknown and cannot improve feasibility, confidence, or score.",
    "target_counting": "A reviewed profile may count toward each application target whose required envelope and evidence it satisfies; application target counts are not added together.",
    "coverage_gate": "Profile and manufacturer minimums are necessary but not sufficient; the declared coverage requirements and all four golden design fixtures must also pass.",
    "closed_contracts": "Persisted profile and manifest validators reject unknown keys recursively; new fields require an explicit schema-version change and migration policy.",
    "profile_path_template": "packages/design-library/parts/<part-class>/<manufacturer-id>/<mpn>.json"
  },
