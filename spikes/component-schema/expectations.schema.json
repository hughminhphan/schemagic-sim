{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencircuit.dev/schemas/expectations.schema.json",
  "title": "OpenCircuit Model Test Expectations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tests"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_netlist",
          "analysis_type",
          "scalar_checks",
          "hard_bounds_checks"
        ],
        "properties": {
          "test_netlist": {
            "type": "string",
            "minLength": 5,
            "pattern": "^[^/]+\\.cir$"
          },
          "analysis_type": {
            "enum": [
              "operating_point",
              "dc_sweep",
              "ac_small_signal",
              "transient",
              "noise",
              "thermal",
              "digital"
            ]
          },
          "scalar_checks": {
            "type": "array",
            "items": { "$ref": "#/$defs/scalarCheck" }
          },
          "hard_bounds_checks": {
            "type": "array",
            "items": { "$ref": "#/$defs/hardBoundsCheck" }
          }
        }
      }
    }
  },
  "$defs": {
    "expressionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expression"],
      "properties": {
        "kind": { "enum": ["raw_variable", "derived_expression"] },
        "expression": { "type": "string", "minLength": 1 }
      }
    },
    "scalarCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expression_source",
        "expected_value",
        "unit",
        "tolerance",
        "datasheet_citation",
        "placeholder"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expression_source": { "$ref": "#/$defs/expressionSource" },
        "expected_value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["absolute", "relative"],
          "properties": {
            "absolute": { "type": "number", "minimum": 0 },
            "relative": { "type": "number", "minimum": 0 }
          }
        },
        "datasheet_citation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S+"
        },
        "placeholder": { "type": "boolean" }
      }
    },
    "hardBoundsCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expression_source",
        "unit",
        "inclusive",
        "datasheet_citation",
        "placeholder"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expression_source": { "$ref": "#/$defs/expressionSource" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "inclusive": { "type": "boolean" },
        "datasheet_citation": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["minimum"] },
        { "required": ["maximum"] }
      ]
    }
  }
}
